# Codex uses your existing local ChatGPT login and the account-default model.
AI_AGENT_PROVIDER=codex
AI_AGENT_MODEL=
AI_AGENT_EFFORT=
CODEX_PATH=codex

# Optional direct OpenAI API provider:
# AI_AGENT_PROVIDER=openai
# AI_AGENT_MODEL=gpt-5.5
# OPENAI_API_KEY=your-api-key-here

# Optional LiteLLM Python SDK provider. Set the provider's normal API-key
# environment variable too, for example ANTHROPIC_API_KEY or GEMINI_API_KEY.
# AI_AGENT_PROVIDER=litellm
# AI_AGENT_MODEL=anthropic/claude-sonnet-4-5-20250929
# AI_AGENT_EFFORT=medium
# AI_AGENT_CONTEXT_WINDOW=200000
# AI_AGENT_LITELLM_API_BASE=
# AI_AGENT_LITELLM_API_KEY=
# AI_AGENT_LITELLM_TIMEOUT_SECONDS=2
